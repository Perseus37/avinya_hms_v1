# Template only. Copy to .env.production on the deployment host and replace
# every REPLACE_* value with unique production settings/secrets.
ENVIRONMENT=production
PRIVACY_ALLOW_AUDIT_ONLY=false
PRIVACY_ALLOW_RETENTION_DRY_RUN=false
PRIVACY_ALLOW_RETENTION_EXECUTE=false
DEVELOPMENT_AUTO_CREATE_SCHEMA=false
PLATFORM_NAME=Avinya HMS
BASE_DOMAIN=REPLACE_WITH_YOUR_DOMAIN
DEFAULT_TENANT_SLUG=default
DEFAULT_HOSPITAL_NAME=REPLACE_WITH_INITIAL_HOSPITAL_NAME
DEFAULT_BRANCH_CODE=REPLACE_WITH_INITIAL_BRANCH_CODE
VERSION=REPLACE_WITH_RELEASE_VERSION
TENANT_URL_TEMPLATE=
API_PORT=8000
API_SERVICE_HOST=api
CONTROL_PLANE_PORT=8080
GUNICORN_WORKERS=4
TENANT_DATABASE_PREFIX=hms_
APP_TIMEZONE=Asia/Kolkata

POSTGRES_USER=REPLACE_WITH_A_DEDICATED_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PRODUCTION_SECRET
POSTGRES_DB=hms_default
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432
CONTROL_PLANE_DB_NAME=hms_control_plane

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_DB=0
REDIS_MAX_MEMORY=512mb
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PRODUCTION_SECRET

API_PUBLISHED_PORT=8000
CONTROL_PLANE_PUBLISHED_PORT=8080
MAX_PAGE_SIZE=200
MIGRATION_PREVIEW_ROWS=5
MIGRATION_PREVIEW_ERROR_LIMIT=100
MIGRATION_MAX_UPLOAD_BYTES=52428800
ATTACHMENTS_STORAGE_DIR=/app/attachments
MAX_ATTACHMENT_UPLOAD_BYTES=20971520
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=60
MIGRATION_MAX_EXPRESSION_DEPTH=20
MIGRATION_MAX_INPUTS=50
BACKUP_INTERVAL_SECONDS=86400
BACKUP_OUTPUT_DIR=backups
# Mount point for the attached backup disk (verify it's mounted before cron).
BACKUP_STORAGE_MOUNTPOINT=/mnt/avinya-data
# Separate directories on one mounted disk, or paths on separate mounted disks.
BACKUP_HOST_PATH=/mnt/avinya-data/backups
ATTACHMENTS_HOST_PATH=/mnt/avinya-data/attachments
VAULT_POLL_INTERVAL_SECONDS=30

SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MASTER_ONBOARDING_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_KEY
CONTROL_PLANE_MASTER_KEY=
CONTROL_PLANE_LEGACY_MASTER_KEY_ENABLED=false
CONTROL_PLANE_ACCESS_TOKEN_MINUTES=15
TRUSTED_PROXY_IPS=REPLACE_WITH_REVERSE_PROXY_IP_OR_CIDR
LOGIN_LOCKOUT_MINUTES=15
MFA_REQUIRED_FOR_PRIVILEGED=true
WS_MAX_CONNECTIONS=100
WS_MAX_WAITING_ROOM_CONNECTIONS=25
BREAK_GLASS_MAX_REQUESTS_PER_DAY=5
HL7_TLS_CERT_FILE=
HL7_TLS_KEY_FILE=
HL7_CLIENT_IDLE_TIMEOUT_SECONDS=300
HL7_LISTEN_HOST=127.0.0.1
HL7_PORT=2575
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://onboard.REPLACE_WITH_YOUR_DOMAIN
SEED_ADMIN_EMAIL=REPLACE_WITH_INITIAL_ADMIN_EMAIL
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_ONE_TIME_ADMIN_PASSWORD
ENVELOPE_ENCRYPTION_SALT=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
ENVELOPE_ENCRYPTION_PREVIOUS_SECRET_KEY=
ENVELOPE_ENCRYPTION_PREVIOUS_SALT=
BACKUP_ENCRYPTION_SALT=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET

MAIL_PROVIDER=smtp
SMTP_HOST=REPLACE_WITH_YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER_ADDRESS
AWS_SES_REGION=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ACME_EMAIL=REPLACE_WITH_OPERATIONS_EMAIL
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
CF_DNS_API_TOKEN=REPLACE_WITH_LEAST_PRIVILEGE_DNS_TOKEN
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# HL7 MLLP Equipment Listener (N-13)
HL7_LISTEN_HOST=127.0.0.1
HL7_PORT=2575
HL7_TLS_CERT_FILE=certs/hl7.crt
HL7_TLS_KEY_FILE=certs/hl7.key

# Off-Host Backup Replication (M-12)
BACKUP_OFFHOST_ENABLED=false
BACKUP_OFFHOST_REMOTE_DIR=
BACKUP_OFFHOST_S3_BUCKET=
BACKUP_OFFHOST_S3_ENDPOINT_URL=
BACKUP_OFFHOST_S3_REGION=
BACKUP_OFFHOST_S3_ACCESS_KEY=
BACKUP_OFFHOST_S3_SECRET_KEY=
BACKUP_OFFHOST_S3_PREFIX=backups

# Telemetry & Prometheus Scraping
METRICS_SCRAPE_TOKEN=REPLACE_WITH_RANDOM_METRICS_SCRAPE_TOKEN
