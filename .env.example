# Local development only. Copy to .env and generate unique secrets.
ENVIRONMENT=development
PRIVACY_ALLOW_AUDIT_ONLY=false
PRIVACY_ALLOW_RETENTION_DRY_RUN=false
PRIVACY_ALLOW_RETENTION_EXECUTE=false
DEVELOPMENT_AUTO_CREATE_SCHEMA=true
PLATFORM_NAME=Avinya HMS Development
BASE_DOMAIN=localhost
DEFAULT_TENANT_SLUG=default
DEFAULT_HOSPITAL_NAME=Avinya Development Hospital
DEFAULT_BRANCH_CODE=HQ-DEV-01
VERSION=development
TENANT_URL_TEMPLATE=
API_PORT=8000
API_SERVICE_HOST=api
CONTROL_PLANE_PORT=8080
GUNICORN_WORKERS=4
TENANT_DATABASE_PREFIX=hms_
APP_TIMEZONE=Asia/Kolkata

# 2. Atomic PostgreSQL Settings
# For native local development (running Uvicorn / scripts on host with Docker db/redis),
# use 127.0.0.1. (Docker Compose internal containers automatically route to 'db').
POSTGRES_USER=avinya
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_DB=hms_default
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432
CONTROL_PLANE_DB_NAME=hms_control_plane

# 3. Atomic Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_DB=0
REDIS_MAX_MEMORY=512mb
REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD

API_PUBLISHED_PORT=8000
CONTROL_PLANE_PUBLISHED_PORT=8080
MAX_PAGE_SIZE=200
MIGRATION_PREVIEW_ROWS=5
MIGRATION_PREVIEW_ERROR_LIMIT=100
MIGRATION_MAX_UPLOAD_BYTES=52428800
ATTACHMENTS_STORAGE_DIR=/app/attachments
MAX_ATTACHMENT_UPLOAD_BYTES=20971520
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=60
MIGRATION_MAX_EXPRESSION_DEPTH=20
MIGRATION_MAX_INPUTS=50
BACKUP_INTERVAL_SECONDS=86400
BACKUP_OUTPUT_DIR=backups
VAULT_POLL_INTERVAL_SECONDS=30

SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MASTER_ONBOARDING_KEY=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
CONTROL_PLANE_MASTER_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_KEY
CONTROL_PLANE_LEGACY_MASTER_KEY_ENABLED=true
CONTROL_PLANE_ACCESS_TOKEN_MINUTES=15
TRUSTED_PROXY_IPS=
LOGIN_LOCKOUT_MINUTES=15
MFA_REQUIRED_FOR_PRIVILEGED=false
WS_MAX_CONNECTIONS=100
WS_MAX_WAITING_ROOM_CONNECTIONS=25
BREAK_GLASS_MAX_REQUESTS_PER_DAY=5
HL7_TLS_CERT_FILE=
HL7_TLS_KEY_FILE=
HL7_CLIENT_IDLE_TIMEOUT_SECONDS=300
HL7_LISTEN_HOST=127.0.0.1
HL7_PORT=2575
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8080
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
ENVELOPE_ENCRYPTION_SALT=REPLACE_WITH_A_RANDOM_LOCAL_SALT
ENVELOPE_ENCRYPTION_PREVIOUS_SECRET_KEY=
ENVELOPE_ENCRYPTION_PREVIOUS_SALT=
BACKUP_ENCRYPTION_SALT=REPLACE_WITH_A_DIFFERENT_RANDOM_LOCAL_SALT

MAIL_PROVIDER=smtp
SMTP_HOST=mailserver
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=provisioning@example.invalid
AWS_SES_REGION=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

VITE_API_PROXY_TARGET=http://localhost:8000

# HL7 MLLP Equipment Listener (N-13)
HL7_LISTEN_HOST=127.0.0.1
HL7_PORT=2575
HL7_TLS_CERT_FILE=certs/hl7.crt
HL7_TLS_KEY_FILE=certs/hl7.key

# Off-Host Backup Replication (M-12)
BACKUP_OFFHOST_ENABLED=false
BACKUP_OFFHOST_REMOTE_DIR=
BACKUP_OFFHOST_S3_BUCKET=
BACKUP_OFFHOST_S3_ENDPOINT_URL=
BACKUP_OFFHOST_S3_REGION=
BACKUP_OFFHOST_S3_ACCESS_KEY=
BACKUP_OFFHOST_S3_SECRET_KEY=
BACKUP_OFFHOST_S3_PREFIX=backups
