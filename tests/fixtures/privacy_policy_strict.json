      "description": "Synthetic test-only purpose.",
      "consent_required": true,
      "legal_basis": "Synthetic fixture only; not legal guidance.",
      "required_before": ["disclose"],
      "scope": "recipient",
      "validity": "until_withdrawn",
      "capture": ["WRITTEN", "OTP"],
      "consenters": ["patient", "guardian"],
      "default_when_no_record": "deny"
    },
    {
      "code": "RESEARCH_IDENTIFIABLE",
      "display_name": "Identifiable research",
      "consent_required": true,
      "legal_basis": "Synthetic fixture only; not legal guidance.",
      "required_before": ["use"],
      "scope": "study",
      "validity": "fixed_term",
      "capture": ["WRITTEN"],
      "consenters": ["patient"],
      "default_when_no_record": "deny"
    }
  ],
  "data_use_points": {
    "fhir.patient.read": "EXTERNAL_SHARING",
    "federation.patient.discover": "EXTERNAL_SHARING"
  },
  "exceptions": [
    {
